# PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public site URL (used for the booking QR code and Open Graph)
NEXT_PUBLIC_SITE_URL=https://midominio.com

# (Optional) Session secret — used for cookie signing if enabled later
# SESSION_SECRET=change-me

# Web Push (VAPID) — generate once with `npx web-push generate-vapid-keys`.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is safe to expose to the browser; VAPID_PRIVATE_KEY must stay secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@correo.com
